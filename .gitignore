# ------------------------------------------------------------------------------
# Central gitignore for the whole repo
# ------------------------------------------------------------------------------

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json

# Environment files
.env
.env.*
*.local

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
venv/
.venv/
env/

# Python build / packaging
build/
dist/
*.egg-info/
*.egg

# Node / frontend
node_modules/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Misc logs
logs/
*.log

