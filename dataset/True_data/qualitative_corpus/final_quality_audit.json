          "chunk_id": "BOARD_OVERSIGHT_board_credit_risk_memo_2024_0003"
        }
      ]
    },
    {
      "text_preview": "Management was asked to continue monitoring delinquency trends, concentration exposure, customer payment behavior, and emerging credit risks.",
      "locations": [
        {
          "file": "BOARD_OVERSIGHT_board_credit_risk_memo_2024.jsonl",
          "chunk_id": "BOARD_OVERSIGHT_board_credit_risk_memo_2024_0004"
        },
        {
          "file": "MDA_BOARD_combined.jsonl",
          "chunk_id": "BOARD_OVERSIGHT_board_credit_risk_memo_2024_0004"
        }
      ]
    },
    {
      "text_preview": "The Board reviewed liquidity and capital indicators and requested that management maintain sufficient capacity to absorb adverse changes in credit conditions.",
      "locations": [
        {
          "file": "BOARD_OVERSIGHT_board_credit_risk_memo_2024.jsonl",
          "chunk_id": "BOARD_OVERSIGHT_board_credit_risk_memo_2024_0005"
        },
        {
          "file": "MDA_BOARD_combined.jsonl",
          "chunk_id": "BOARD_OVERSIGHT_board_credit_risk_memo_2024_0005"
        }
      ]
    },
    {
      "text_preview": "The Board requested periodic reporting on material changes in portfolio quality, risk concentrations, and credit-loss expectations.",
      "locations": [
