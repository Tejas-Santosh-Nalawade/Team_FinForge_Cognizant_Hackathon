          "chunk_id": "BOARD_OVERSIGHT_board_credit_risk_memo_2024_0002"
        }
      ]
    },
    {
      "text_preview": "Management reported that overall credit quality remained within the Board-approved risk appetite. Concentrations in selected customer and lending segments were reviewed.",
      "locations": [
        {
          "file": "BOARD_OVERSIGHT_board_credit_risk_memo_2024.jsonl",
